[Unit]
Description=ciXnet static gateway information page
After=network.target

[Service]
DynamicUser=yes
ExecStart=/usr/bin/busybox httpd -f -p 80 -h /var/www/cixnet-gateway
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
Restart=on-failure
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
